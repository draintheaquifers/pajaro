(defn update-keys
  [m f]
  (let [ret (persistent!
             (reduce-kv (fn [acc k v] (assoc! acc (f k) v))
                        (transient {})
                        m))]
    (with-meta ret (meta m))))

(defn resultset-seq
  [sth]
  (if-let [row (try
                 (.fetchrow_hashref sth)
                 (catch :default _oops nil))]
    (let [kw-row (update-keys row keyword)]
      (cons kw-row (lazy-seq (resultset-seq sth))))))

(defmacro defn-
  [name & decls]
    (list* `defn (with-meta name (assoc (meta name) :private true)) decls))

(defn tree-seq
   [branch? children root]
   (let [walk (fn walk [node]
                (lazy-seq
                 (cons node
                  (when (branch? node)
                    (mapcat walk (children node))))))]
     (walk root)))

(def file-seq
  (let [dir-contents ;; including hidden; other than ., ..
        (fn [d]
          (with-open [h (Perl.FileHandle.)]
            (CORE/opendir h d)
            (into []
                  (comp (remove #{"." ".."})
                        (map #(str d "/" %)))
                  (vector (CORE/readdir h)))))]
    (fn [dir]
      (tree-seq
       (fn node? [x] ;; node?: a directory which is not a symlink (to avoid cycles)
         (and
          (Pajaro.HOPerl/filetest_d x)
          (not (Pajaro.HOPerl/filetest_l x))))
       dir-contents ;; children
       dir ;; root
       ))))

(defn flatten
  [x]
  (filter (complement sequential?)
          (rest (tree-seq sequential? seq x))))

(defn make-hierarchy []
  (Pajaro.TypeHierarchy.))

(defn alter-var-root [v f & args]
  (._set_root_binding_BANG_ v (apply f @v args)))

(defn derive
  ([tag parent]
   (alter-var-root #'global-hierarchy derive tag parent))
  ([h tag parent]
   (-derive h tag parent)))

(defn descendants
  ([tag]
   (descendants global-hierarchy tag))
  ([h tag]
   (-descendants h tag)))

(def set? (fn* [x] (satisfies? clojure.core.ISet x)))

(defn set [coll]
  (if (set? coll)
    coll
    (into #{} coll)))

(defn isa?
  ([child parent] (isa? global-hierarchy child parent))
  ([h child parent]
   (or (= child parent)
       (contains? (set (ancestors global-hierarchy child)) parent)
       (when (not (identical? h global-hierarchy))
         (contains? (set (ancestors h child)) parent))
       (and (vector? parent) (vector? child)
            (= (count parent) (count child))
            (loop [ret true i 0]
              (if (or (not ret) (= i (count parent)))
                ret
                (recur (isa? h (child i) (parent i)) (inc i))))))))

(defprotocol IMultimethod
  "Multimethod"
  (addMethod [this v f])
  (remove-method [this v])
  (remove-all-methods [this])
  (prefer-method [this w l])
  (methods [this])
  (get-method [this v])
  (prefers [this]))

(deftype Multimethod [mm-name dispatch-f dflt h v2f w2l invoke-f]
  IMultimethod
  (addMethod [this v f] (set! v2f (assoc v2f v f)) this)
  (remove-method [this v] (set! v2f (dissoc v2f v)) this)
  (remove-all-methods [this]
                      (set! v2f (hash-map))
                      (set! w2l (hash-map))
                      this)
  (prefer-method [this w l] (set! w2l (update w2l w (fnil conj #{}) l)) this)
  (methods [this] v2f)
  (prefers [this] w2l)
  (get-method [this v]
              (or (get v2f v)
                  (let [dvs (seq (into []
                                       (filter v2f) ;; actual dispatch values, still in relevance order
                                       (ancestors @h v) ;; things that might be dispatch values
                                       ))
                        losers (into #{}
                                     (mapcat w2l)
                                     dvs)
                        dv (first (remove losers dvs))
                        ]
                    (get v2f dv))
                  (get v2f dflt)
                  (throw (str "No method in multimethod '" mm-name "' for dispatch value: " v))))
  IFn
  (-code [this] ;; in connection with which, deftype declares "use overload '&{}'"
         (or invoke-f
             (set! invoke-f (fn [& args]
                              (let [v (apply (.-dispatch-f this) args)]
                                (apply (get-method this v) args))))))

  IPr
  (-pr-str [this] (str "#<Multimethod-" mm-name ">")))

(defmacro defmulti [mm-name & options]
  (let [docstring   (if (string? (first options))
                      (first options)
                      nil)
        options     (if (string? (first options))
                      (next options)
                      options)
        m           (if (map? (first options))
                      (first options)
                      {})
        options     (if (map? (first options))
                      (next options)
                      options)
        dispatch-fn (first options)
        options     (next options)
        m           (if docstring
                      (assoc m :doc docstring)
                      m)
        m           (if (meta mm-name)
                      (conj (meta mm-name) m)
                      m)
        mm-name (with-meta mm-name m)]
    (when (= (count options) 1)
      (throw "The syntax for defmulti has changed. Example: (defmulti name dispatch-fn :default dispatch-value)"))
    (when-not dispatch-fn
      (throw "Missing dispatch-fn"))
    (let [options   (apply hash-map options)
          default   (get options :default :default)
          hierarchy (get options :hierarchy #'global-hierarchy)]
      `(defonce ~mm-name
         (->Multimethod ~(name mm-name)
                        ~dispatch-fn
                        ~default
                        ~hierarchy
                        {}
                        {}
                        nil)))))

(defmacro defmethod
  [multifn dispatch-val & fn-tail]
  `(.addMethod ~multifn ~dispatch-val (fn ~@fn-tail)))

(defn printf [& xs]
  (print (apply CORE/sprintf xs)))

(defn alter-meta! [r f & args]
  (reset-meta! r (apply f (meta r) args)))

(alter-meta! #'*ns* assoc :dynamic true)

(defn create-ns [dq-sym]
  (Pajaro/-setup-ns (name dq-sym)))

(defn intern [ns & xs]
  (let [ns-object (the-ns ns)]
    (apply Pajaro/-intern (.get_name ns-object) xs)))

(defn remove-ns [dq-sym]
  (binding* [*out* *err*]
            (println "Cannot remove any ns, not even" dq-sym)))

(defn in-ns [dq-sym]
  (set! clojure.core/*ns* (Pajaro/-setup-ns (name dq-sym)))
  (let [perlstmt (str "package " (Pajaro/_namespace_munge (.get_name *ns*)) ";")]
    (perl-eval perlstmt)))

(defn ns-map [ns-clue]
  (let [ns (the-ns ns-clue)]
    (reduce
     (fn [a e]
       (assoc a (symbol (key e)) (val e)))
     {}
     (.contents ns))))

(defn ns-aliases [ns-clue]
  (let [ns (the-ns ns-clue)]
    (reduce
     (fn [a e]
       (assoc a (symbol (key e)) (val e)))
     {}
     (.aliases ns))))

(defn alias [alias namespace-sym]
  (assoc! (.aliases *ns*) (name alias) (the-ns namespace-sym)))

(defn -ns-map-filtered [ns-clue f]
  (let [ns (the-ns ns-clue)
        all (ns-map ns)
        ns-name-str (.get_name ns)]
    (reduce
     (fn [a [k v]]
       (if (f v)
         a
         (dissoc a k)))
     all
     all)))

(defn ns-publics [ns-clue]
  (let [ns (the-ns ns-clue)
        all (ns-map ns)
        ns-name-str (.get_name ns)]
    (-ns-map-filtered
     ns
     (fn [v]
       (and
        (= "Pajaro::Var" (CORE/ref v))
        (= ns-name-str (.get_namespace v))
        (not (re-matches #"^-[a-z]" (.get_name v))))))))

(defn ns-interns [ns-clue]
  (let [ns (the-ns ns-clue)
        all (ns-map ns)
        ns-name-str (.get_name ns)]
    (-ns-map-filtered
     ns
     (fn [v]
       (and
        (= "Pajaro::Var" (CORE/ref v))
        (= ns-name-str (.get_namespace v)))))))

(defn ns-refers [ns-clue]
  (let [ns (the-ns ns-clue)
        all (ns-map ns)
        ns-name-str (.get_name ns)]
    (-ns-map-filtered
     ns
     (fn [v]
       (and
        (= "Pajaro::Var" (CORE/ref v))
        (not= ns-name-str (.get_namespace v)))))))

(defn ns-imports [ns-clue]
  (let [ns (the-ns ns-clue)
        all (ns-map ns)
        ns-name-str (.get_name ns)]
    (-ns-map-filtered
     ns
     (fn [v]
       (= "Pajaro::Symbol" (CORE/ref v))))))

(defn refer [ns-sym & filters]
  (let [ns (or (find-ns ns-sym) (throw (str "No namespace: " ns-sym)))
        fs (apply hash-map filters)
        nspublics (ns-publics ns)
        rename (or (:rename fs) {})
        exclude (set (:exclude fs))
        to-do (if (= :all (:refer fs))
                (keys nspublics)
                (or (:refer fs) (:only fs) (keys nspublics)))]
    (when (and to-do (not (sequential? to-do)))
      (throw (str ":only/:refer value must be a sequential collection of symbols, but got " (pr-str to-do))))
    (doseq [sym to-do]
      (when-not (exclude sym)
        (let [v (nspublics sym)]
          (when-not v
            (if (get (ns-interns ns) sym)
              (throw (str sym " is not public"))
              (throw (str sym " does not exist"))))
          (intern *ns* (or (rename sym) sym) v)))))
  *ns*)

(defn refer-clojure [& _xs]
  (refer (symbol "clojure.core")))

(defmacro ns
  ;; clojure.core -> Pajaro
  ;; rmv gen-class
  ;; waive the name-metadata part...
  ;; .equals -> with =
  ;; rmv dosync and commute->swap!
  ;; elide with-loading-context
  [name & references]
  (let [process-reference
        (fn [[kname & args]]
          `(~(symbol "clojure.core" (clojure.core/name kname))
             ~@(seq (into []
                          (map #(list 'quote %))
                          args))))
        docstring  (when (string? (first references)) (first references))
        references (if docstring (next references) references)
        name (if docstring
               (vary-meta name assoc :doc docstring)
               name)
        metadata   (when (map? (first references)) (first references))
        references (if metadata (next references) references)
        name (if metadata
               (vary-meta name merge metadata)
               name)
        name-metadata (meta name)]
    `(do
       (clojure.core/in-ns '~name)
       ~@(when name-metadata
           `((reset-meta! (clojure.core/the-ns '~name) ~name-metadata)))
       ~@(when (and (not= name 'clojure.core) (not-any? #(= :refer-clojure (first %)) references))
           `((clojure.core/refer '~'clojure.core)))
       ~@(seq (into []
                    (map process-reference)
                    references))
        (if (= '~name 'clojure.core)
          nil
          (do (swap! @#'*loaded-libs* conj '~name) nil)))))

(defonce ^:dynamic *loaded-libs* (atom #{'clojure.core}))

(defonce ^:dynamic *pending-paths* ())

(defonce ^:dynamic *loading-verbosely* false)

(defn -throw-if
  [pred fmt & args]
  (when pred
    (let [message (apply str fmt args)]
      (throw message))))

(defn -libspec?
  [x]
  (or (symbol? x)
      (and (vector? x)
           (or
            (nil? (second x))
            (keyword? (second x))))))

(defn -prependss
  "Prepends a symbol or a seq to coll"
  [x coll]
  (if (symbol? x)
    (cons x coll)
    (concat1 x coll)))

(def re-quote CORE/quotemeta)

(defn -root-resource
  "Returns the root directory path for a lib"
  [lib]
  (str \/
       (-> (name lib)
           (Pajaro.HOPerl/perl_replace_all \- \_)
           (Pajaro.HOPerl/perl_replace_all (re-quote \.) \/))))

(defn -root-directory
  "Returns the root resource path for a lib"
  [lib]
  (let [[_ d] (re-matches #"(.*)/[^/]*" (-root-resource lib))]
    d))

(defn -load-one
  [lib need-ns require]
  (load (-root-resource lib))
  (-throw-if (and need-ns (not (find-ns lib)))
            "namespace '%s' not found after loading '%s'"
            lib (-root-resource lib))
  (when require
    (swap! *loaded-libs* conj lib)))

(defn -load-all
  [lib need-ns require]
  (swap! *loaded-libs* #(reduce1 conj %1 %2)
         (binding* [*loaded-libs* (atom #{})]
           (-load-one lib need-ns require)
           @*loaded-libs*)))

(defn -load-lib
  [prefix lib & options]
  (-throw-if (and prefix (re-find #"[.]" (name lib)))
             "Found lib name '%s' containing period with prefix '%s'.  lib names inside prefix lists must not contain periods"
             (name lib) prefix)
  (let [lib (if prefix (symbol (str prefix \. lib)) lib)
        opts (apply hash-map options)
        {:keys [as reload reload-all require use verbose as-alias]} opts
        loaded (contains? @*loaded-libs* lib)
        need-ns (or as use)
        load (cond reload-all -load-all
                   reload -load-one
                   (not loaded) (cond need-ns -load-one
                                      as-alias (fn [lib _need _require] (create-ns lib))
                                      :else -load-one))

        filter-opts (select-keys opts '(:exclude :only :rename :refer))
        undefined-on-entry (not (find-ns lib))]
    (binding* [*loading-verbosely* (or *loading-verbosely* verbose)]
      (if load
        (try
          (load lib need-ns require)
          (catch :default e
            (when undefined-on-entry
              (remove-ns lib))
            (throw e)))
        (-throw-if (and need-ns (not (find-ns lib)))
                   "namespace '%s' not found" lib))
      (when (and need-ns *loading-verbosely*)
        (printf "(clojure.core/in-ns '%s)\n" (ns-name *ns*)))
      (when as
        (when *loading-verbosely*
          (printf "(clojure.core/alias '%s '%s)\n" as lib))
        (alias as lib))
      (when as-alias
        (when *loading-verbosely*
          (printf "(clojure.core/alias '%s '%s)\n" as-alias lib))
        (alias as-alias lib))
      (when (or use (:refer filter-opts))
        (when *loading-verbosely*
          (printf "(clojure.core/refer '%s" lib)
          (doseq [opt filter-opts]
            (printf " %s '%s" (key opt) (print-str (val opt))))
          (printf ")\n"))
        (apply refer lib (into []
                               (mapcat seq)
                               filter-opts))))))

(defn -load-libs
  "Loads libs, interpreting libspecs, prefix lists, and flags for
  forwarding to load-lib"
  [& args]
  (let [flags (into []
                    (filter keyword?)
                    args)
        opts (interleave* flags (repeat true))
        args (seq (into []
                        (filter (complement keyword?))
                        args))]
    ;; check for unsupported options
    (let [supported #{:as :reload :reload-all :require :use :verbose :refer :as-alias}
          unsupported (seq (into []
                                 (remove supported)
                                 flags))]
      (-throw-if unsupported
                 (apply str "Unsupported option(s) supplied: "
                        (into []
                              (interpose \,)
                              unsupported))))
                                        ; check a load target was specified
    (-throw-if (not (seq args)) "Nothing specified to load")
    (doseq [arg args]
      (if (-libspec? arg)
        (apply -load-lib nil (-prependss arg opts))
        (let [[prefix & args] arg]
          (-throw-if (nil? prefix) "prefix cannot be nil")
          (doseq [arg args]
            (apply -load-lib prefix (-prependss arg opts))))))))

(defn -check-cyclic-dependency
  [path]
  (when (some #{path} (rest *pending-paths*))
    (let [pending (into []
                        (map #(if (= % path) (str "[ " % " ]") %))
                        (cons path *pending-paths*))
          chain (apply str (into []
                                 (interpose "->")
                                 pending))]
      (-throw-if true "Cyclic load dependency: %s" chain))))

(defn require
  [& args]
  ;; Detect collision with Perl's require and delegate to it.
  ;; Perl's "use" and "no" statements generate a "require" call!
  (if (and (= 1 (count args))
           (string? (nth args 0)))
    (do
      ((perl-eval "sub{my $x=shift;CORE::require $x}") (nth args 0)))
    (apply -load-libs :require args)))

(defn import* [pkg args]
  (when-not (re-matches #"[_.a-zA-Z0-9]+" pkg)
    (throw (str "Bad package name. Use Data.Dumper for Data::Dumper")))
  (let [perlpkg (Pajaro.HOPerl/perl_replace_all pkg #"[.]" "::")
        arglist (when (seq args)
                  (str "("
                       (apply str
                              (into []
                                    (comp
                                     (map pr-str)
                                     (interpose ","))
                                    args))
                       ")"))
        perlstmt (str "use " perlpkg arglist ";")]
    (perl-eval perlstmt)))

;; Hazard! Collision with Perl's implicit module-"import"
;; (which Perl invokes after "require" or "use")...
;; kluged by `intern` putting a decoy into Perl's symbol table.
;; Thus the import macro is callable only via the Var (scalar entry in symbol table).
(defmacro import
  [& import-symbols-or-lists]
  (let [specs (into []
                    (map #(if (and (seq? %) (= 'quote (first %)))
                            (second %)
                            %))
              import-symbols-or-lists)]
    `(do ~@(into []
                 (map (fn [spec]
                        (if (symbol? spec)
                          (list 'clojure.core/import* (name spec) nil)
                          (list 'clojure.core/import* (name (first spec))
                                (into [] (map str) (second spec))))))
                 specs))))

(defprotocol IRecord
  "Marker protocol indicating a record.")

(defmacro defrecord [recname-sym members & protocols-and-methods]
  ;; TYPE member _* is a COWMap of the members
  (let [mbr-perl (fn* [mbr-sym]
                      `(get ~'_* ~(keyword (name mbr-sym))))
        basis-ks (into #{}
                       (map (comp keyword name))
                       members)
	dotted-recname-sym (symbol
                            (str (name (ns-name *ns*))
                                 "." (name recname-sym)))
        typ-ctor-sym (gensym (str "new-" (name recname-sym)))]
    `(do
       (declare ~typ-ctor-sym)
       (deftype* ~recname-sym
         :constructor "new0" ;; deftype's ctor will be "new0"; ours (below) is "new"
         [~'_* ~'mt]
         ;; user-defined methods
         ~@(map
            (fn method* [protocol-or-method]
              (if (symbol? protocol-or-method)
                protocol-or-method ;; i.e., protocol symbol
                (if (list? protocol-or-method) ;; i.e., method implementation
                  (let [[method-symbol method-args & method-body] protocol-or-method]
                    `(~method-symbol
                      ~method-args
                      (let [~@(into []
                                    (mapcat
                                     (fn member* [member]
                                       (list member (mbr-perl member))))
                                    members)]
                        ~@method-body)))
                  (throw "expected protocol (symbol) or method (list)"))))
            protocols-and-methods)
         ;; automatic methods
         ~'clojure.core.IRecord
         ~'clojure.core.ICloneable
         (~'clone [~'this]
          (~typ-ctor-sym ~'_* ~'mt))
         ~'clojure.core.IHash
         (~'hash [~'this] (inc (hash ~'_*)))
         ~'clojure.core.IEquiv
         (~'-equiv [~'this ~'other]
          (and
           (= (type ~'this) (type ~'other))
           (= ~'_* (hget ~'other "_*"))))
         ~'clojure.core.IMeta
         (~'meta [~'this] ~'mt)
         ~'clojure.core.IPr
         (~'-pr-str [~'this]
          (str "<" ~(name dotted-recname-sym) "=" ~'_* ">"))
         ~'clojure.core.IPrint
         (~'-pr-str [~'this]
          (str "<" ~(name dotted-recname-sym) "=" ~'_* ">"))
         ~'clojure.core.IWithMeta
         (~'with-meta [~'this meta#]
          ;; should we enforce meta is nil or a map?
          (~typ-ctor-sym ~'_* meta#))
         ~'clojure.core.IAssoc
         (~'assoc [~'this ~'& args#]
          (~typ-ctor-sym (apply assoc ~'_* args#) ~'mt))
         ~'clojure.core.IAssociative
         ~'clojure.core.IDissoc
         (~'dissoc [~'this ~'& ks#]
          (let [content# (apply dissoc ~'_* ks#)]
            (if (seq (into []
                           (filter ~basis-ks)
                           ks#))
              content#
              (~typ-ctor-sym content# ~'mt))))
         ~'clojure.core.IFind
         (~'find [~'this ~'& args#]
          (apply find ~'_* args#))
         ~'clojure.core.IKeysVals
         (~'keys [~'this]
          (keys ~'_*))
         (~'vals [~'this]
          (vals ~'_*))
         ~'clojure.core.ILookup
         (~'contains? [~'this k#]
          (contains? ~'_* k#))
         (~'get [~'this ~'& args#]
          (apply get ~'_* args#))
         ~'clojure.core.ISeqable
         (~'seq [~'this]
          (seq ~'_*)))
       (defn ~typ-ctor-sym [mbrmap# meta#]
         (. ~dotted-recname-sym ~'new0 mbrmap# meta#))
       (defn ~(symbol (str "->" (name recname-sym)))
         ~members                       ; [arg1 arg2...]
         (let [mbrmap# ~(zipmap
                         (into []
                               (map (comp keyword name))
                               members)
                         members)
               meta# nil]
           (. ~dotted-recname-sym ~'new0 mbrmap# meta#)))
       (defn ~(symbol (str "map->" (name recname-sym)))
         [m#]
         (let [empty-basis-map# ~(zipmap (into []
                                               (map (comp keyword name))
                                               members)
                                         (repeat nil))
               meta# nil]
           (. ~dotted-recname-sym ~'new0 (merge empty-basis-map# m#) meta#)))
       (let [new-code#
             '(fn* ~(vec (cons '_ members))
                          (let [mbrmap# ~(zipmap
                                          (into []
                                                (map (comp keyword name))
                                                members)
                                          members)
                                meta# nil]
                            (. ~dotted-recname-sym ~'new0 mbrmap# meta#)))
             new-perlcode# (Pajaro.Salt/toPerl
                            (Pajaro.Transpiler/transpile
                             #perl {}   ; options
                             new-code#
                             #perl {}   ; env
                             ))
             in-pkg-perlcode# (str "{package " ~(Pajaro/-namespace-munge
                                                 (clojure.core/name dotted-recname-sym)) ";"
                                   "no warnings qw(redefine);"
                                   "*new = " new-perlcode# ";"
                                   "}")]
         (perl-eval in-pkg-perlcode#)))))

(def record? (fn* [x] (satisfies? clojure.core.IRecord x)))

(import 'Time.HiRes)

(defn sleep [ms]
  (Time.HiRes/sleep (/ ms 1000))
  nil)

(defn cycle [coll]
  (if (seq coll)
    (letfn [(cycler [current]
              (lazy-seq (cons (first current)
                              (cycler (or (next current) coll)))))]
      (cycler coll))
    ()))

(defmacro binding [bindings & body]
  (let [pairs (partition1 2 bindings)
        vars (into [] (map first) pairs)
        exprs (into [] (map second) pairs)
        temps (repeatedly (count pairs) gensym)
        temp-bindings (interleave* temps exprs)
        dynamic-bindings (interleave* vars temps)]
    `(let [~@temp-bindings]
       (binding* [~@dynamic-bindings]
                 ~@body))))

(def format CORE/sprintf)

(defn butlast [s]
  (loop [ret [] s s]
    (if (next s)
      (recur (conj ret (first s)) (next s))
      (seq ret))))

(defn int-array
  ([size-or-seq]
   (if (coll? size-or-seq)
     (into-array (map int size-or-seq))
     (into-array (repeat size-or-seq 0))))
  ([size init-val-or-seq]
   (if (coll? init-val-or-seq)
     (into-array (take size (concat (map int init-val-or-seq) (repeat 0))))
     (into-array (repeat size (int init-val-or-seq))))))

(def long-array int-array)

(defn double-array
  ([size-or-seq]
   (if (coll? size-or-seq)
     (into-array (map double size-or-seq))
     (into-array (repeat size-or-seq 0.0))))
  ([size init-val-or-seq]
   (if (coll? init-val-or-seq)
     (into-array (take size (concat (map double init-val-or-seq) (repeat 0.0))))
     (into-array (repeat size (double init-val-or-seq))))))

(def float-array double-array)

(defn object-array [size-or-seq]
  (if (coll? size-or-seq)
    (into-array size-or-seq)
    (into-array (repeat size-or-seq nil))))

(defn some-fn
  [& preds]
  (when (zero? (count preds))
    (throw "Predicates missing"))
  (if (not-every? ifn? preds)
    (fn [& args]
      (throw "Predicates must be fns"))
    (fn [& args]
    (loop [preds preds]
      (when-let [pred (first preds)]
        (or (loop [args args]
              (when-let [arg (first args)]
                (or (pred arg)
                    (recur (rest args)))))
            (recur (rest preds))))))))

(defn rand
  ([]
   (CORE/rand 1))
  ([n]
   (CORE/rand n)))

(defn rand-int [n]
  (int (CORE/rand n)))

(defn rand-nth
  [coll]
  (nth coll (rand-int (count coll))))

(defn random-sample
  ([prob]
   (filter (fn [_] (< (rand) prob))))
  ([prob coll]
   (filter (fn [_] (< (rand) prob)) coll)))

(defn counted? [x] (satisfies? clojure.core.ICounted x))

(defmacro extend-type
  [typ & protos-meths]
  ;; Pajaro/-extend-type takes alternating protocol object & PERL map of method name => CODE
  (let [proto->meths (loop [ret {} current-proto nil p-ms protos-meths]
                       (if-let [p-m (first p-ms)]
                         (if (symbol? p-m)
                           (recur
                            (assoc ret p-m #perl {})
                            p-m
                            (rest p-ms))
                           (recur
                            (update ret
                                    current-proto
                                    assoc!
                                    (name (first p-m))
                                    (cons 'clojure.core/fn p-m))
                            current-proto
                            (rest p-ms)))
                         ret))]
   `(apply Pajaro/-extend-type
          ~typ
          ~(into []
                 (mapcat identity)
                 proto->meths))))

(defmacro extend-protocol
  [proto & types-meths]
  ;; Pajaro/_extend_protocol takes proto, 1 type, 1 PERL map of methodname=>CODE
  (let [type->meths (loop [ret {} current-type nil t-ms types-meths]
                       (if-let [t-m (first t-ms)]
                         (if (symbol? t-m)
                           (recur
                            (assoc ret t-m #perl {})
                            t-m
                            (rest t-ms))
                           (recur
                            (update ret
                                    current-type
                                    assoc!
                                    (name (first t-m))
                                    (cons 'clojure.core/fn t-m))
                            current-type
                            (rest t-ms)))
                         ret))]
    `(do
       ~@(seq
          (into []
                (map
                 (fn [[t mm]]
                   `(Pajaro/_extend_protocol ~proto ~t ~mm)))
                type->meths)))))

(defn parse-boolean
  [s]
  (if (string? s)
    (case s
      "true" true
      "false" false
      nil)
    (throw (str "Expected string, got " (type s)))))

(defn println-str
  [& xs]
  (str (apply print-str xs) "\n"))

(defn prn-str
  [& xs]
  (str (apply pr-str xs) "\n"))

(Pajaro/-extend-type Pajaro.Var IWatchable)

;;---  promises

(defprotocol IPromise
  (deliver [this x]))

(defn -promise-notify-watches [r o n]
  (loop [ws (.-watchers r)]
    (let [w (first ws)]
      (if w
        (let [k (key w)
              f (val w)]
          (f k r o n)
          (recur (rest ws)))
        nil))))

(deftype Promise [delivered payload meta watchers]
  IPromise
  (deliver [this x]
    (if-not delivered
      (let [o payload]
        (set! delivered true)
        (set! payload x)
        (-promise-notify-watches this o payload)
        this)
      nil))

  IEquiv
  (-equiv [o other] (identical? o other))

  IDeref
  (deref [_]
    (when-not delivered
      (throw (ex-info "Promise not delivered" {})))
    payload)

  IFn
  (-code [this]
    (fn [x] (deliver this x)))

  IMeta
  (meta [_] meta)

  IHash
  (hash [this] 42)

  IPending
  (realized? [this]
    delivered)

  IResetMeta
  (reset-meta! [this m]
    (when (and m (not (map? m)))
      (throw "meta must be nil or a map"))
    (set! meta m))

  IPr
  (-pr-str [this]
    (str "Promise<" (if delivered (pr-str payload) "undelivered") ">"))

  IWatchable
  (add-watch [this k f]
    (set! watchers (assoc! watchers k f))
    this)
  (remove-watch [this k]
    (set! watchers (dissoc! watchers k))
    this))

(defn promise
  []
  (->Promise false nil {} {}))

(defn rationalize [n]
  (simplify-BigRat-to-BigNum (rationalize* n)))

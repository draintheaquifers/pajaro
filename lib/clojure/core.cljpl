  (do
    (with-open [fh (Perl.FileHandle. "somefile.txt" "w")]
      (binding [*out* fh]
        (println "Hello, file!")
        (println "hello again")))

    (with-open [fh (Perl.FileHandle. "somefile.txt" "r")]
      (binding [*in* fh]
        [(read-line) (read-line)])))

  :-)

(defn line-seq
  [fh]
  (when-let [line (read-line* fh)]
    (cons line (lazy-seq (line-seq fh)))))

(comment

  (with-open [fh (Perl.FileHandle. "somefile.txt" "r")]
    (doall (line-seq fh)))
  :-)

(defmacro doto
  [x & forms]
  (let [gx (gensym)]
    `(let [~gx ~x]
       ~@(seq
          (into []
                (map (fn [f]
                       (with-meta
                         (if (seq? f)
                           `(~(first f) ~gx ~@(next f))
                           `(~f ~gx))
                         (meta f))))
                forms))
       ~gx)))

;; Clojure subs : s, start,  end (end is EXCLUSIVE)
;;  Perl substr : s, offset, length
(defn subs
  ([s start]
   (when-not (string? s) (throw "subs needs a string"))
   (when-not (number? start) (throw "start index is not a number"))
   (when-not (<= 0 start (count s)) (throw "start index out of range"))
   (CORE/substr s start))
  ([s start end]
   (when-not (string? s) (throw "subs needs a string"))
   (when-not (number? start) (throw "start index is not a number"))
   (when-not (<= 0 start (count s)) (throw "start index out of range"))
   (when-not (<= start end (count s)) (throw "end index out of range"))
   (when-not (number? end) (throw "end index is not a number"))
   (CORE/substr s start (- end start))))

(defn re-seq [re t]
  (when t
    (if-let [m (re-find re t)]
      (let [matched (if (vector? m)
                      (nth m 0)
                      m)
            remainder (subs t (+ (count matched) (CORE/index t matched)))]
        (cons m (lazy-seq (re-seq re remainder)))))))

(extend Pajaro.COWList
  IIndexed
  {:nth (fn
          ([this i]
           (if (zero? i)
             (first this)
             (when-let [more (next this)]
               (recur more (dec i)))))
          ([this i else]
           (loop [this this i i]
             (if (zero? i)
               (first this)
               (if-let [more (next this)]
                 (recur more (dec i))
                 else)))))})

(defn partition
  ([n coll]
   (partition n n coll))
  ([n step coll]
   (lazy-seq
    (when-let [s (seq coll)]
      (let [p (seq (into [] (take n) s))]
        (when (= n (count p))
          (cons p (partition n step (nthrest s step))))))))
  ([n step pad coll]
   (lazy-seq
    (when-let [s (seq coll)]
      (let [p (seq (into [] (take n) s))]
        (if (= n (count p))
          (cons p (partition n step pad (nthrest s step)))
          (list (take n (concat p pad)))))))))

(defmacro when-first
  [bindings & body]
  (let [[x xs] bindings]
    `(when-let [xs# (seq ~xs)]
       (let [~x (first xs#)]
           ~@body))))

(defmacro for
  [seq-exprs body-expr]
  (let [to-groups (fn [seq-exprs]
                    (reduce1 (fn [groups [k v]]
                               (if (keyword? k)
                                 (conj (pop groups) (conj (peek groups) [k v]))
                                 (conj groups [k v])))
                             []
                             (partition1 2 seq-exprs)))
        err (fn [& msg] (throw (apply str msg)))
        emit-bind (fn emit-bind [[[bind expr & mod-pairs]
                                  & [[_ next-expr] :as next-groups]]]
                    (let [giter (gensym "iter__")
                          gxs (gensym "s__")
                          do-mod (fn do-mod [[[k v :as pair] & etc]]
                                   (cond
                                     (= k :let) `(let ~v ~(do-mod etc))
                                     (= k :while) `(when ~v ~(do-mod etc))
                                     (= k :when) `(if ~v
                                                    ~(do-mod etc)
                                                    (recur (rest ~gxs)))
                                     (keyword? k) (err "Invalid 'for' keyword " k)
                                     next-groups
                                     `(let [iterys# ~(emit-bind next-groups)
                                            fs# (seq (iterys# ~next-expr))]
                                        (if fs#
                                          (concat fs# (~giter (rest ~gxs)))
                                          (recur (rest ~gxs))))
                                     :else `(cons ~body-expr
                                                  (~giter (rest ~gxs)))))]
                      (if next-groups
                        #_"not the inner-most loop"
                        `(fn ~giter [~gxs]
                           (lazy-seq
                            (loop [~gxs ~gxs]
                              (when-first [~bind ~gxs]
                                ~(do-mod mod-pairs)))))
                        #_"inner-most loop"
                        `(fn ~giter [~gxs]
                           (lazy-seq
                            (loop [~gxs ~gxs]
                              (when-let [~gxs (seq ~gxs)]
                                (let [~bind (first ~gxs)]
                                  ~(do-mod mod-pairs)))))))))]
    `(let [iter# ~(emit-bind (to-groups seq-exprs))]
       (iter# ~(second seq-exprs)))))

(comment
  (for [a [1 2 3]
        :when (odd? a)]
    (inc a))

  (for [a [1 2 3]
        :when (odd? a)
        b [:a :b :c]
        c '(42 43 44)]
    [(inc a) :b c])

  :-)

(defmacro doseq
  [seq-exprs & body]
  (let [step (fn step [recform exprs]
               (if-not exprs
                 [true `(do ~@body)]
                 (let [k (first exprs)
                       v (second exprs)]
                   (if (keyword? k)
                     (let [steppair (step recform (nnext exprs))
                           needrec (steppair 0)
                           subform (steppair 1)]
                       (cond
                         (= k :let) [needrec `(let ~v ~subform)]
                         (= k :while) [false `(when ~v
                                                ~subform
                                                ~@(when needrec [recform]))]
                         (= k :when) [false `(if ~v
                                               (do
                                                 ~subform
                                                 ~@(when needrec [recform]))
                                               ~recform)]))
                     (let [seq- (gensym "seq_")
                           count- (gensym "count_")
                           i- (gensym "i_")
                           recform `(recur (next ~seq-) 0 0)
                           steppair (step recform (nnext exprs))
                           needrec (steppair 0)
                           subform (steppair 1)]
                       [true
                        `(loop [~seq- (seq ~v),
                                ~count- 0, ~i- 0]
                           (when-let [~seq- (seq ~seq-)]
                             (let [~k (first ~seq-)]
                               ~subform
                               ~@(when needrec [recform]))))])))))]
    (nth (step nil (seq seq-exprs)) 1)))

